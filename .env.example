# TripPick 환경변수
# cp .env.example .env  후 값을 채운다. .env 는 절대 커밋하지 않는다.

# ---------- Core ----------
APP_ENV=local
# 아무 긴 랜덤 문자열. API 인증에 쓰인다.
APP_API_TOKEN=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://trip:trip@db:5432/trippick
TZ=Asia/Seoul
PUBLIC_WEB_URL=http://localhost:3000
LOG_LEVEL=INFO

# ---------- Sources ----------
# 비워두면 해당 어댑터만 disabled 되고 앱은 정상 동작한다.

# https://www.travelpayouts.com  (가입 → 대시보드) — 항공/호텔 최저가 주력 소스
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# https://developers.amadeus.com (Self-Service 무료 티어) — 실가격 검증용
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# https://www.data.go.kr — TourAPI / 고캠핑 / 기상청 (활용신청 후 발급)
DATA_GO_KR_KEY=

# 환율 — Phase 1 필수다 (Amadeus 가 EUR/USD 로 응답하므로 원화 환산에 필요).
# 한국수출입은행 오픈API: https://www.koreaexim.go.kr → 인증키 신청
# 주말·공휴일에는 데이터가 없으므로 마지막 영업일 환율로 폴백해야 한다.
EXIM_API_KEY=

# ---------- Notify ----------
# 쉼표 구분. 나중에 telegram,inapp 으로 바꾸면 텔레그램으로 전환된다.
NOTIFY_CHANNELS=slack,inapp

# Slack App → Incoming Webhooks → Add New Webhook to Workspace
SLACK_WEBHOOK_URL=

# Phase 1.5 에서 사용 (@BotFather 로 봇 생성 후 토큰, getUpdates 로 chat_id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 같은 알림 재발송 억제 시간
ALERT_COOLDOWN_HOURS=12
# 이 시간대에는 severity=great 만 발송한다 (KST 기준)
QUIET_HOURS=23:00-08:00

# ---------- Collect ----------
DEFAULT_INTERVAL_MIN=360
# 목표가의 이 배수 이내로 들어온 후보만 Amadeus 실가격 검증에 태운다 (쿼터 절약)
VERIFY_THRESHOLD_RATIO=1.15
# 오퍼 원본 보관 일수 (초과분은 일 1회 정리)
OFFER_RETENTION_DAYS=90

# ---------- Crawl (기본 off) ----------
# true 로 켜도 sources/policy.py 의 robots.txt 게이트를 통과해야 동작한다.
CRAWL_ENABLED=false
CRAWL_MIN_INTERVAL_SEC=5
# 봇임을 숨기지 않는다. 연락 가능한 주소를 넣는다.
HTTP_USER_AGENT=TripPick/0.1 (personal price watcher; contact: you@example.com)
